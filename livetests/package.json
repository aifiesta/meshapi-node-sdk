{
  "name": "meshapi-sdk-test",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "meshapi-node-sdk": "file:..",
    "ws": "^8.18.0"
  },
  "scripts": {
    "test:models": "node --test test-models.js",
    "test:templates": "node --test test-templates.js",
    "test:chat": "node --test test-chat.js",
    "test:stream": "node --test test-stream.js",
    "test:inference": "node --test test-inference.js",
    "test:errors": "node --test test-errors.js",
    "test:feature": "node --test test-feature-matrix.js",
    "test:rag": "node --test test-rag.js",
    "test:realtime": "node --test test-realtime.js",
    "test:structured-output": "node --test test-structured-output.js",
    "test:audio": "node --test test-audio.js",
    "test:video": "node --test test-video.js",
    "test:compare": "node --test test-compare.js",
    "test:moderations": "node --test test-moderations.js",
    "test:web-search": "node --test test-web-search.js",
    "test:router-select": "node --test test-router-select.js",
    "test:tool-calling": "node --test test-tool-calling.js",
    "test:images-edit": "node --test test-images-edit.js",
    "test:responses": "node --test test-responses.js",
    "test:on-response": "node --test test-on-response.js",
    "test:smoke": "node --test test-models.js test-chat.js test-stream.js test-errors.js test-api-version.js && node --test --test-name-pattern=\"embeddings|responses\" test-inference.js",
    "test:all": "node --test --test-reporter=spec"
  }
}
