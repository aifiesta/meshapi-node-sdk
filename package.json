{
  "name": "meshapi-node-sdk",
  "version": "2.0.0",
  "description": "Official TypeScript SDK for Mesh API. One OpenAI-compatible key, 321 LLMs, unified billing, prompt templates, batches.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx/esm --test \"tests/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "meshapi",
    "openai",
    "llm",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@valibot/to-json-schema": "^1.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@valibot/to-json-schema": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@valibot/to-json-schema": "^1.0.0",
    "valibot": "^1.0.0",
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
